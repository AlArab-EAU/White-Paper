# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log
test
prompt

# Local dev scripts & screenshots (not part of the whitepaper source)
/scripts/

# Z.ai sandbox internal
/.zscripts/

# Local SQLite database (sandbox only)
/db/
/prisma/*.db
/prisma/*.db-journal

# Sandbox tool-results (internal CLI artifacts)
/tool-results/

# Tests directory (sandbox bootstrap scripts)
/tests/

# Skills directory
/skills/

# Examples (sandbox demos, not part of the whitepaper)
/examples/

# Mini-services (sandbox demos)
/mini-services/

# Caddyfile (sandbox reverse proxy config)
/Caddyfile

# Upload directory (user-supplied source files)
/upload/

# Download directory (local deliverables)
/download/
